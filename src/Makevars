# mgcca links against the BigDataStatMeth C++ headers, which require HDF5
# (Rhdf5lib), BLAS/LAPACK and OpenMP. Flags mirror BigDataStatMeth's Makevars.

CXX_STD = CXX17

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DBOOST_NO_CONCEPT_CHECKING -DSTRICT_R_HEADERS

# OpenMP + BLAS/LAPACK + Fortran runtime
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# Rhdf5lib (static HDF5 C/C++ libs)
RHDF5_LIBS = $(shell echo 'Rhdf5lib::pkgconfig("PKG_CXX_LIBS")' | \
    "${R_HOME}/bin/R" --vanilla --slave)
PKG_LIBS += $(RHDF5_LIBS)
