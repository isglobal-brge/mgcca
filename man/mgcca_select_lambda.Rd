ids <- Reduce(union, list(rownames(X1), rownames(X2), rownames(X3)))[1:150]
mk  <- function(d, j = NULL) {
    m <- as.matrix(d[rownames(d) \%in\% ids, , drop = FALSE])
    if (!is.null(j)) m <- m[, j, drop = FALSE]
    storage.mode(m) <- "double"
    m
